# Copy to .env and fill in. .env is gitignored and must never be committed —
# this repository is public, and a leaked credential is indexed within minutes.

# --- Database -----------------------------------------------------------------
# node-pg-migrate reads DATABASE_URL directly, so the app and the migrations
# stay on one connection string rather than two that can disagree.
DATABASE_URL=postgres://bookworm:CHANGE_ME@localhost:5432/wormbook

# --- HTTP ---------------------------------------------------------------------
PORT=3000
# Bind to loopback by default. On the VPS the reverse proxy is the only thing
# that should reach this port; Node never faces the internet directly.
HOST=127.0.0.1

# --- Runtime ------------------------------------------------------------------
# production | development | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
