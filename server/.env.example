# Copy to .env and fill in. .env is gitignored and must never be committed —
# this repository is public, and a leaked credential is indexed within minutes.

# --- Database -----------------------------------------------------------------
# The server has its OWN database. It is deliberately NOT `wormbook`, which is
# the desktop app's live library: the ownership migration adds a NOT NULL
# user_id column that the desktop app knows nothing about, so pointing this at
# `wormbook` would stop the app being able to insert a book.
#
# `npm run migrate:*` refuses to run against `wormbook` for that reason. Create
# the server's database first:
#
#   createdb bookworm_dev
#
# node-pg-migrate reads DATABASE_URL directly, so the app and the migrations
# stay on one connection string rather than two that can disagree.
DATABASE_URL=postgres://sqtx@localhost:5432/bookworm_dev

# --- HTTP ---------------------------------------------------------------------
PORT=3000
# Bind to loopback by default. On the VPS the reverse proxy is the only thing
# that should reach this port; Node never faces the internet directly.
HOST=127.0.0.1

# --- Runtime ------------------------------------------------------------------
# production | development | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
