# Build (matches at any depth, so desktop/build/ is covered)
build/

# Node (server/)
node_modules/
coverage/
npm-debug.log*

# Secrets — never commit. This repo is public; a leaked credential is indexed
# within minutes and git revert does not remove it from history.
.env
.env.*
!.env.example

# Private assets (original resources)
Priv/

# Claude
CLAUDE.md

# macOS
.DS_Store
*.dSYM/

# Qt Creator
CMakeLists.txt.user
*.pro.user
*.qmlc
*.jsc

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Compiled
*.o
*.a
*.dylib
*.so
*.app
moc_*
qrc_*
ui_*

# iOS / Xcode
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/**/DerivedData/
ios/**/.swiftpm/
ios/**/build/
# SwiftPM's own build directory, which `build/` above does not match.
ios/**/.build/
*.xcuserstate
